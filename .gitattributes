# Normalize line endings to LF in the repository for every text file.  Without this rule a Windows
# checkout (core.autocrlf=false) writes CRLF into the working tree, and every text file reports as
# modified while its content is byte-identical.  The rules below win where they apply: the
# launchers keep their platform endings, and the -text entries below are hashed byte for byte.
* text=auto
# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
bin/strata text eol=lf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text

# the quant yardstick's text set: tokenized byte for byte (set.ids.json), never convert its line endings
data/quant_quality/** -text

# the license text is shipped and checked as LF text on every checkout
LICENSE text eol=lf

# container scripts run in Linux: always LF
docker/*.sh text eol=lf
Dockerfile text eol=lf
docker/Dockerfile text eol=lf
docker/compose/* text eol=lf

# Apple tools (codesign, plutil) read these: LF only, wherever the repository is cloned
*.plist text eol=lf

# vendored KaTeX (serve/web/vendor): the files are hashed byte for byte (PROVENANCE.json), never convert their line endings.
serve/web/vendor/** -text

# recorded community results and their task fixtures are reproduced byte for byte (a fixture counts as
# benchmark input), and this file is generated: never convert their line endings
bench/results/** -text
data/gguf_fingerprints.json -text
# the launch scripts recorded inside them are launchers too: they keep the rules above
bench/results/**/*.bat text eol=crlf
bench/results/**/*.cmd text eol=crlf
bench/results/**/*.ps1 text eol=crlf
bench/results/**/*.sh text eol=lf
